//UCFFIND  JOB (ACCT),'UCF LOOKUP',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* AD HOC LOOKUPS WITH IDCAMS PRINT. A KEY SHORTER THAN THE FULL KEY
//* IS GENERIC, SO FROMKEY(SMITH) TOKEY(SMITH) RETURNS EVERY RECORD
//* WHOSE LAST NAME STARTS WITH SMITH (SMITH, SMITHSON, ...).
//*
//* BYLAST  BASE KSDS, KEY = LASTNAME + PROPERTY ID
//* BYPROP  THROUGH THE PATH, KEY = 26-BYTE PROPERTY ID ALONE
//*         (HOLDER ID 12 + YEAR 4 + TYPE 4 + SEQUENCE 6). A SHORTER
//*         VALUE IS GENERIC: 740550600002 RETURNS ALL OF THAT HOLDER
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//*
//BYLAST   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  PRINT INDATASET(&HLQ..OWNER.KSDS) -
        FROMKEY(SMITH) TOKEY(SMITH) -
        CHARACTER
/*
//BYPROP   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  PRINT INDATASET(&HLQ..OWNER.PROPID.PATH) -
        FROMKEY(7405506000021989UT01000098) -
        TOKEY(7405506000021989UT01000098) -
        CHARACTER
/*
