//UCFLOAD  JOB (ACCT),'UCF TAPE LOAD',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* LOAD THE TEXAS UCF TAPE INTO THE KSDS DEFINED BY UCFDEF
//*
//* STEP LOAD   DFSORT ICETOOL:
//*   - READS THE 469-BYTE FB TAPE RECORDS
//*   - INREC BUILDS THE 66-BYTE KEY (LASTNAME 1-40 + PROPERTY ID 202-227)
//*     IN FRONT OF THE UNCHANGED RECORD (535 BYTES IN ALL)
//*   - SORTS ON THE KEY AND WRITES STRAIGHT INTO THE EMPTY KSDS
//*     (SORT WORK SPACE IS DYNAMICALLY ALLOCATED IF YOUR SITE ALLOWS
//*     DYNALLOC; OTHERWISE ADD SORTWK01-03 DDS TO THIS STEP)
//*   - FIRST RECORD OF ANY DUPLICATE KEY GOES TO THE KSDS; THE REST GO
//*     TO &HLQ..OWNER.DUPKEYS FOR REVIEW (A KSDS CANNOT HOLD DUPLICATE
//*     KEYS). TOOLMSG SHOWS HOW MANY.
//* STEP BLDAIX IDCAMS BLDINDEX BUILDS THE PROPERTYID ALTERNATE INDEX
//*
//* STEP LOADSTAT  UCFCTLU STAMPS THE LOAD DATE IN UCF.CTL (NEEDS UCFCLDEF
//*              RUN ONCE, AND UCF.CTL CLOSED IN CICS). AFTER THIS JOB,
//*              RUN UCFLOOK (REQUIRED) AND UCFSDX (OPTIONAL).
//* CHANGE: JOB CARD, HLQ, TAPE DSN/VOLSER/UNIT, LOADLIB (PLACEHOLDERS.MD)
//* TO RELOAD, RERUN UCFDEF FIRST (THE KSDS MUST BE EMPTY).
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//         SET TAPEDSN=UCF.TAPE.INPUT
//         SET VOLSER=UCF001
//         SET LOADLIB=UCF.PROD.LOADLIB
//*
//CLEANUP  EXEC PGM=IEFBR14
//DUPS     DD DSN=&HLQ..OWNER.DUPKEYS,DISP=(MOD,DELETE,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//LOAD     EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TAPEIN   DD DSN=&TAPEDSN,DISP=OLD,
//             UNIT=TAPE,VOL=SER=&VOLSER,LABEL=(1,SL)
//*            FOR AN UNLABELED TAPE USE LABEL=(1,NL) AND ADD:
//*            DCB=(RECFM=FB,LRECL=469,BLKSIZE=nnnnn)
//KSDS     DD DSN=&HLQ..OWNER.KSDS,DISP=OLD
//DUPS     DD DSN=&HLQ..OWNER.DUPKEYS,
//             DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(50,50),RLSE),
//             DCB=(RECFM=FB,LRECL=535,BLKSIZE=0)
//TOOLIN   DD *
  SELECT FROM(TAPEIN) TO(KSDS) ON(1,66,CH) FIRST DISCARD(DUPS) -
         USING(CTL1)
  COUNT  FROM(DUPS)
/*
//CTL1CNTL DD *
  INREC BUILD=(1,40,202,26,1,469)
/*
//*
//BLDAIX   EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//IDCUT1   DD UNIT=SYSDA,SPACE=(CYL,(500,100)),DISP=(NEW,DELETE)
//IDCUT2   DD UNIT=SYSDA,SPACE=(CYL,(500,100)),DISP=(NEW,DELETE)
//SYSIN    DD *,SYMBOLS=JCLONLY
  BLDINDEX INDATASET(&HLQ..OWNER.KSDS) -
           OUTDATASET(&HLQ..OWNER.PROPID.AIX) -
           EXTERNALSORT
  LISTCAT ENTRIES(&HLQ..OWNER.KSDS &HLQ..OWNER.PROPID.AIX) ALL
/*
//*
//LOADSTAT EXEC PGM=UCFCTLU,COND=(4,LT),
//             PARM='LOADSTAT,&HLQ..OWNER.KSDS'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//UCFCTL   DD DSN=&HLQ..UCF.CTL,DISP=SHR
//SYSOUT   DD SYSOUT=*
