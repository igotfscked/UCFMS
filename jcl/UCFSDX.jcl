//UCFSDX   JOB (ACCT),'UCF SOUNDEX BUILD',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* OPTIONAL: BUILD THE "SOUNDS LIKE" LOOKUP FILE FROM THE OWNER KSDS.
//* NOTHING ELSE DEPENDS ON IT. IF IT IS NEVER BUILT, OR IS OLDER THAN
//* THE LAST OWNER LOAD (SNDXSTAT VS LOADSTAT IN UCF.CTL), QUERY JUST
//* REFUSES "SOUNDS LIKE" SEARCHES. RUN IT AFTER UCFLOAD IF WANTED.
//*
//*  &HLQ..OWNER.SNDXLKP  KSDS 70  KEYS(70 0)
//*     1- 4  SOUNDEX(OWNERLASTNAME), FIRST LETTER + 3 DIGITS
//*     5-70  OWNER KEY (LAST NAME 40 + PROPERTY ID 26)
//*  CODES COME FROM COBOL ROUTINE UCFSNDX, THE SAME ONE QUERY CALLS,
//*  SO LOAD AND SEARCH ALWAYS AGREE. NAMES WITH NO LETTERS ARE LEFT OUT.
//*
//* NEEDS: UCFSNDX AND UCFSDXB IN THE LOAD LIBRARY (UCFCOMP), AND
//* UCF.CTL (UCFCLDEF) CLOSED IN CICS FOR THE LAST STEP.
//* CHANGE: JOB CARD, HLQ, LOADLIB, SPACE (SEE PLACEHOLDERS.MD)
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//         SET LOADLIB=UCF.PROD.LOADLIB
//*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  DELETE &HLQ..OWNER.SNDXLKP CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER ( -
           NAME(&HLQ..OWNER.SNDXLKP) -
           INDEXED KEYS(70 0) RECORDSIZE(70 70) -
           FREESPACE(0 0) SHAREOPTIONS(2 3) SPEED -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA (NAME(&HLQ..OWNER.SNDXLKP.DATA) -
           CYLINDERS(1000 200) CONTROLINTERVALSIZE(8192)) -
         INDEX (NAME(&HLQ..OWNER.SNDXLKP.INDEX))
/*
//*
//CODES    EXEC PGM=UCFSDXB,COND=(0,LT)
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//OWNER    DD DSN=&HLQ..OWNER.KSDS,DISP=SHR
//SDXOUT   DD DSN=&&SDX,DISP=(NEW,PASS),UNIT=SYSDA,
//             SPACE=(CYL,(1000,200),RLSE),DSNTYPE=LARGE,
//             DCB=(RECFM=FB,LRECL=70,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//*
//LOAD     EXEC PGM=SORT,COND=(0,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&&SDX,DISP=(OLD,DELETE)
//SORTOUT  DD DSN=&HLQ..OWNER.SNDXLKP,DISP=OLD
//SYSIN    DD *
  SORT FIELDS=(1,70,CH,A)
/*
//*
//SNDXSTAT EXEC PGM=UCFCTLU,COND=(0,LT),
//             PARM='SNDXSTAT,&HLQ..OWNER.SNDXLKP'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//UCFCTL   DD DSN=&HLQ..UCF.CTL,DISP=SHR
//SYSOUT   DD SYSOUT=*
