//UCFDEF   JOB (ACCT),'UCF VSAM DEFINE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* DEFINE THE TEXAS UCF VSAM FILES
//*
//*  BASE KSDS  &HLQ..OWNER.KSDS
//*    RECORD = 535 BYTES = 66-BYTE KEY PREFIX + ORIGINAL 469-BYTE REC
//*      1- 40  KEY: OWNERLASTNAME (TAPE COLS 1-40)
//*     41- 66  KEY: PROPERTY ID   (TAPE COLS 202-227 = HOLDERIDNUMBER
//*                  + HOLDERREPORTYEAR + PROPERTYTYPE + SEQUENCENUMBER)
//*     67-535  ORIGINAL UCF RECORD, UNCHANGED (TAPE OFFSETS + 66)
//*    KEYS(66 0)
//*
//*  ALTERNATE INDEX  &HLQ..OWNER.PROPID.AIX
//*    KEY = PROPERTY ID IN THE ORIGINAL RECORD: OFFSET 66+201=267, LEN 26
//*    READ IT THROUGH THE PATH &HLQ..OWNER.PROPID.PATH
//*
//* SPACE IS SIZED FOR ROUGHLY 10 MILLION RECORDS ON 3390:
//*   18K DATA CI = 34 RECS/CI, 3 CI/TRK -> ~1,530 RECS/CYL BEFORE FREESPACE
//* OVER 4 GB NEEDS AN SMS DATA CLASS WITH EXTENDED ADDRESSABILITY:
//* UNCOMMENT DATACLAS AND USE YOUR SITE'S CLASS NAME.
//*
//* CHANGE: JOB CARD, HLQ BELOW, SPACE, DATACLAS/STORCLAS.
//* RERUNNABLE: DELETES THE CLUSTER (AND ITS AIX/PATH) FIRST.
//* RUN UCFLOAD AFTER THIS JOB.
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  DELETE &HLQ..OWNER.KSDS CLUSTER PURGE
  SET MAXCC = 0

  DEFINE CLUSTER ( -
           NAME(&HLQ..OWNER.KSDS) -
           INDEXED -
           KEYS(66 0) -
           RECORDSIZE(535 535) -
           FREESPACE(10 10) -
           SHAREOPTIONS(2 3) -
           SPEED -
  /*       DATACLAS(XXXXXXXX)  */ -
  /*       STORCLAS(XXXXXXXX)  */ -
         ) -
         DATA ( -
           NAME(&HLQ..OWNER.KSDS.DATA) -
           CYLINDERS(9000 1000) -
           CONTROLINTERVALSIZE(18432) -
         ) -
         INDEX ( -
           NAME(&HLQ..OWNER.KSDS.INDEX) -
         )

  DEFINE ALTERNATEINDEX ( -
           NAME(&HLQ..OWNER.PROPID.AIX) -
           RELATE(&HLQ..OWNER.KSDS) -
           KEYS(26 267) -
           NONUNIQUEKEY -
           UPGRADE -
           RECORDSIZE(97 32000) -
           FREESPACE(10 10) -
           SHAREOPTIONS(2 3) -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA ( -
           NAME(&HLQ..OWNER.PROPID.AIX.DATA) -
           CYLINDERS(1200 200) -
           CONTROLINTERVALSIZE(32768) -
         ) -
         INDEX ( -
           NAME(&HLQ..OWNER.PROPID.AIX.INDEX) -
         )

  DEFINE PATH ( -
           NAME(&HLQ..OWNER.PROPID.PATH) -
           PATHENTRY(&HLQ..OWNER.PROPID.AIX) -
           UPDATE -
         )

  LISTCAT ENTRIES(&HLQ..OWNER.KSDS) ALL
/*
