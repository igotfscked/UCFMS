//UCFCOMP  JOB (ACCT),'UCF COMPILE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* COMPILE AND LINK THE BATCH COBOL FOR THE LOAD JOBS:
//*   UCFSNDX  SOUNDEX ROUTINE (ALSO CALLED BY QUERY IN ISPF AND CICS)
//*   UCFSDXB  SOUNDEX LOOKUP BUILDER (CALLS UCFSNDX, LINKED STATICALLY)
//*   UCFCTLU  STAMPS BUILD RECORDS IN UCF.CTL (USES COPYBOOK UCFCTL)
//* UPLOAD ../COBOL/*.CBL TO SRCLIB AND ../DESIGN/COPYBOOKS/*.CPY TO
//* CPYLIB FIRST. USES THE IBM-SUPPLIED PROC IGYWCL; IF YOUR SITE HAS
//* ITS OWN COMPILE PROC OR CEE LIBRARY NAMES, CHANGE THEM HERE.
//* CHANGE: JOB CARD, SRCLIB, CPYLIB, LOADLIB, CEELKED (PLACEHOLDERS.MD)
//*--------------------------------------------------------------------
//         SET SRCLIB=UCF.PROD.SOURCE
//         SET CPYLIB=UCF.PROD.COPYLIB
//         SET LOADLIB=UCF.PROD.LOADLIB
//         SET CEELKED=CEE.SCEELKED
//*
//SNDX     EXEC IGYWCL,PARM.COBOL='RENT,NODYNAM'
//COBOL.SYSIN   DD DSN=&SRCLIB(UCFSNDX),DISP=SHR
//LKED.SYSLMOD  DD DSN=&LOADLIB(UCFSNDX),DISP=SHR
//*
//SDXB     EXEC IGYWCL,PARM.COBOL='RENT,NODYNAM',COND=(4,LT)
//COBOL.SYSIN   DD DSN=&SRCLIB(UCFSDXB),DISP=SHR
//LKED.SYSLIB   DD DSN=&CEELKED,DISP=SHR
//              DD DSN=&LOADLIB,DISP=SHR
//LKED.SYSLMOD  DD DSN=&LOADLIB(UCFSDXB),DISP=SHR
//*
//CTLU     EXEC IGYWCL,PARM.COBOL='RENT,NODYNAM',COND=(4,LT)
//COBOL.SYSIN   DD DSN=&SRCLIB(UCFCTLU),DISP=SHR
//COBOL.SYSLIB  DD DSN=&CPYLIB,DISP=SHR
//LKED.SYSLMOD  DD DSN=&LOADLIB(UCFCTLU),DISP=SHR
