//UCFLOOK  JOB (ACCT),'UCF LOOKUP BUILD',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* BUILD THE HOLDER-NAME AND OWNER-ZIP LOOKUP FILES FROM THE OWNER
//* KSDS. RUN AFTER EVERY UCFLOAD: A RELOAD MAKES THE OLD ONES STALE.
//* (LAST-NAME SEARCH NEEDS NO LOOKUP: LAST NAME LEADS THE BASE KEY.)
//*
//* WHY NOT ALTERNATE INDEXES: ONE AIX RECORD HOLDS ALL BASE KEYS FOR
//* ONE VALUE, ABOUT 550 AT MOST. ZIP 00000 AND BIG HOLDERS FAR EXCEED
//* THAT. A LOOKUP KSDS HAS ONE SMALL RECORD PER OWNER RECORD INSTEAD.
//*
//*  &HLQ..OWNER.HOLDLKP  KSDS 106  KEYS(106 0)
//*     1- 40 HOLDERNAME   (OWNER REC 345-384 = TAPE 279 + 66)
//*    41-106 OWNER KEY    (OWNER REC 1-66)
//*     RECORDS WITH A BLANK HOLDER NAME ARE LEFT OUT.
//*  &HLQ..OWNER.ZIPLKP   KSDS 79   KEYS(75 0)
//*     1-  9 OWNERZIPCODE (OWNER REC 259-267 = TAPE 193 + 66)
//*    10- 75 OWNER KEY    (OWNER REC 1-66)
//*    76- 79 PROPERTYTYPECODE, DATA ONLY (OWNER REC 284-287), SO
//*           TYPE + ZIP SEARCHES FILTER WITHOUT READING THE BASE
//*     ZIP 00000 AND BLANK ZIPS (UNKNOWN) ARE LEFT OUT.
//*
//* SEARCH: GENERIC BROWSE ON THE HOLDER NAME OR ON 5 OR 9 ZIP DIGITS,
//* THEN READ THE OWNER RECORD BY THE 66-BYTE KEY IN THE LOOKUP RECORD.
//* LAST STEPS STAMP HOLDSTAT/ZIPSTAT IN UCF.CTL (UCFCTLU); THEY NEED
//* THE CLAIMS FILES DEFINED (UCFCLDEF) AND UCF.CTL CLOSED IN CICS.
//*
//* CHANGE: JOB CARD, HLQ, LOADLIB, SPACE (SEE PLACEHOLDERS.MD)
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//         SET LOADLIB=UCF.PROD.LOADLIB
//*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  DELETE &HLQ..OWNER.HOLDLKP CLUSTER PURGE
  DELETE &HLQ..OWNER.ZIPLKP  CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER ( -
           NAME(&HLQ..OWNER.HOLDLKP) -
           INDEXED KEYS(106 0) RECORDSIZE(106 106) -
           FREESPACE(0 0) SHAREOPTIONS(2 3) SPEED -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA (NAME(&HLQ..OWNER.HOLDLKP.DATA) -
           CYLINDERS(1500 300) CONTROLINTERVALSIZE(8192)) -
         INDEX (NAME(&HLQ..OWNER.HOLDLKP.INDEX))
  DEFINE CLUSTER ( -
           NAME(&HLQ..OWNER.ZIPLKP) -
           INDEXED KEYS(75 0) RECORDSIZE(79 79) -
           FREESPACE(0 0) SHAREOPTIONS(2 3) SPEED -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA (NAME(&HLQ..OWNER.ZIPLKP.DATA) -
           CYLINDERS(800 200) CONTROLINTERVALSIZE(8192)) -
         INDEX (NAME(&HLQ..OWNER.ZIPLKP.INDEX))
/*
//*
//HOLDER   EXEC PGM=SORT,COND=(0,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&HLQ..OWNER.KSDS,DISP=SHR
//SORTOUT  DD DSN=&HLQ..OWNER.HOLDLKP,DISP=OLD
//SYSIN    DD *
  INCLUDE COND=(345,1,CH,NE,C' ')
  INREC BUILD=(345,40,1,66)
  SORT FIELDS=(1,106,CH,A)
/*
//*
//ZIP      EXEC PGM=SORT,COND=(0,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&HLQ..OWNER.KSDS,DISP=SHR
//SORTOUT  DD DSN=&HLQ..OWNER.ZIPLKP,DISP=OLD
//SYSIN    DD *
  OMIT COND=(259,5,CH,EQ,C'00000',OR,259,1,CH,EQ,C' ')
  INREC BUILD=(259,9,1,66,284,4)
  SORT FIELDS=(1,75,CH,A)
/*
//*
//HOLDSTAT EXEC PGM=UCFCTLU,COND=(0,LT),
//             PARM='HOLDSTAT,&HLQ..OWNER.HOLDLKP'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//UCFCTL   DD DSN=&HLQ..UCF.CTL,DISP=SHR
//SYSOUT   DD SYSOUT=*
//ZIPSTAT  EXEC PGM=UCFCTLU,COND=(0,LT),
//             PARM='ZIPSTAT,&HLQ..OWNER.ZIPLKP'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//UCFCTL   DD DSN=&HLQ..UCF.CTL,DISP=SHR
//SYSOUT   DD SYSOUT=*
