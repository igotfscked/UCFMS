//UCFCLDEF JOB (ACCT),'UCF CLAIMS DEFINE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* DEFINE THE UCFMS CLAIMS FILES  (LAYOUTS: DESIGN/CLAIMS_LAYOUT.MD)
//*
//*  &HLQ..CLAIM.HDR    KSDS 700  KEY CLAIM ID        KEYS(10 0)
//*    .BYUSER  AIX  UNIQUE  USER+STATUS+CLAIM ID     KEYS(19 10)
//*    .BYSTAT  AIX  UNIQUE  STATUS+CLAIM ID          KEYS(11 18)
//*  &HLQ..CLAIM.ITEM   KSDS 246  KEY CLAIM ID + SEQ  KEYS(14 0)
//*    .BYPROP  AIX  NONUNIQUE  66-BYTE OWNER KEY     KEYS(66 14)
//*  &HLQ..CLAIM.AUDIT  ESDS 210  APPEND ONLY
//*  &HLQ..UCF.CTL      KSDS 100  KEY RECORD ID       KEYS(8 0)
//*  EACH AIX IS IN ITS BASE'S UPGRADE SET AND HAS A PATH NAMED
//*  <AIX>.PATH; CICS FILE RESOURCES FOR AIX ACCESS POINT AT THE PATH.
//*
//* THIS JOB NEVER DELETES ANYTHING. CLAIMS DATA IS NOT RELOADABLE,
//* SO IF A FILE ALREADY EXISTS ITS DEFINE FAILS (RC 12) AND THE JOB
//* STOPS. TO REBUILD FROM SCRATCH, DELETE THE FILES BY HAND FIRST.
//*
//* SEEDING: EACH FILE GETS ONE SEED RECORD SO IT IS NEVER EMPTY
//* (AN EMPTY, NEVER-LOADED VSAM FILE CAN'T BE OPENED FOR INPUT, AND
//* BLDINDEX NEEDS A RECORD). PROGRAMS MUST SKIP THEM:
//*   CLAIM.HDR    CLAIM ID 0000000000, STATUS BLANK
//*   CLAIM.ITEM   CLAIM ID 0000000000, SEQ 0000, STATUS R
//*   CLAIM.AUDIT  CLAIM ID 0000000000, ACTION 'IN' (FILES DEFINED)
//*   UCF.CTL      'CLAIMNO ' WITH LAST CLAIM ID 0 (THE REAL COUNTER)
//*
//* CICS RECOVERY: EITHER DEFINE THE CICS FILE RESOURCES WITH
//* RECOVERY(BACKOUTONLY), OR UNCOMMENT LOG(UNDO) BELOW (SMS-MANAGED
//* DATASETS ONLY; REQUIRED IF YOU USE RLS).
//*
//* CHANGE: JOB CARD, HLQ, SPACE, DATACLAS/STORCLAS (SEE PLACEHOLDERS.MD)
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  DEFINE CLUSTER ( -
           NAME(&HLQ..CLAIM.HDR) -
           INDEXED KEYS(10 0) RECORDSIZE(700 700) -
           FREESPACE(10 10) SHAREOPTIONS(2 3) -
  /*       LOG(UNDO)           */ -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA (NAME(&HLQ..CLAIM.HDR.DATA) -
           CYLINDERS(100 50) CONTROLINTERVALSIZE(4096)) -
         INDEX (NAME(&HLQ..CLAIM.HDR.INDEX))

  DEFINE CLUSTER ( -
           NAME(&HLQ..CLAIM.ITEM) -
           INDEXED KEYS(14 0) RECORDSIZE(246 246) -
           FREESPACE(20 10) SHAREOPTIONS(2 3) -
  /*       LOG(UNDO)           */ -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA (NAME(&HLQ..CLAIM.ITEM.DATA) -
           CYLINDERS(300 100) CONTROLINTERVALSIZE(4096)) -
         INDEX (NAME(&HLQ..CLAIM.ITEM.INDEX))

  DEFINE CLUSTER ( -
           NAME(&HLQ..CLAIM.AUDIT) -
           NONINDEXED RECORDSIZE(210 210) -
           SHAREOPTIONS(2 3) -
  /*       LOG(UNDO)           */ -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA (NAME(&HLQ..CLAIM.AUDIT.DATA) -
           CYLINDERS(300 100) CONTROLINTERVALSIZE(8192))

  DEFINE CLUSTER ( -
           NAME(&HLQ..UCF.CTL) -
           INDEXED KEYS(8 0) RECORDSIZE(100 100) -
           FREESPACE(20 20) SHAREOPTIONS(2 3) -
  /*       LOG(UNDO)           */ -
         ) -
         DATA (NAME(&HLQ..UCF.CTL.DATA) -
           TRACKS(1 1) CONTROLINTERVALSIZE(4096)) -
         INDEX (NAME(&HLQ..UCF.CTL.INDEX))

  DEFINE ALTERNATEINDEX ( -
           NAME(&HLQ..CLAIM.HDR.BYUSER) -
           RELATE(&HLQ..CLAIM.HDR) -
           KEYS(19 10) UNIQUEKEY UPGRADE -
           RECORDSIZE(34 34) FREESPACE(20 10) SHAREOPTIONS(2 3) -
         ) -
         DATA (NAME(&HLQ..CLAIM.HDR.BYUSER.DATA) CYLINDERS(10 5)) -
         INDEX (NAME(&HLQ..CLAIM.HDR.BYUSER.INDEX))
  DEFINE PATH (NAME(&HLQ..CLAIM.HDR.BYUSER.PATH) -
           PATHENTRY(&HLQ..CLAIM.HDR.BYUSER) UPDATE)

  DEFINE ALTERNATEINDEX ( -
           NAME(&HLQ..CLAIM.HDR.BYSTAT) -
           RELATE(&HLQ..CLAIM.HDR) -
           KEYS(11 18) UNIQUEKEY UPGRADE -
           RECORDSIZE(26 26) FREESPACE(20 10) SHAREOPTIONS(2 3) -
         ) -
         DATA (NAME(&HLQ..CLAIM.HDR.BYSTAT.DATA) CYLINDERS(10 5)) -
         INDEX (NAME(&HLQ..CLAIM.HDR.BYSTAT.INDEX))
  DEFINE PATH (NAME(&HLQ..CLAIM.HDR.BYSTAT.PATH) -
           PATHENTRY(&HLQ..CLAIM.HDR.BYSTAT) UPDATE)

  DEFINE ALTERNATEINDEX ( -
           NAME(&HLQ..CLAIM.ITEM.BYPROP) -
           RELATE(&HLQ..CLAIM.ITEM) -
           KEYS(66 14) NONUNIQUEKEY UPGRADE -
           RECORDSIZE(85 4000) FREESPACE(20 10) SHAREOPTIONS(2 3) -
         ) -
         DATA (NAME(&HLQ..CLAIM.ITEM.BYPROP.DATA) -
           CYLINDERS(100 50) CONTROLINTERVALSIZE(8192)) -
         INDEX (NAME(&HLQ..CLAIM.ITEM.BYPROP.INDEX))
  DEFINE PATH (NAME(&HLQ..CLAIM.ITEM.BYPROP.PATH) -
           PATHENTRY(&HLQ..CLAIM.ITEM.BYPROP) UPDATE)
/*
//*
//* SEED ONE RECORD PER FILE (FIELD-BY-FIELD: NUMERIC = ZEROS,
//* TEXT = BLANKS; BUILT FROM DESIGN/CLAIMS_LAYOUT.MD)
//SEED     EXEC PGM=SORT,COND=(0,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD *
SEED
/*
//HDR      DD DSN=&HLQ..CLAIM.HDR,DISP=OLD
//ITEM     DD DSN=&HLQ..CLAIM.ITEM,DISP=OLD
//AUDIT    DD DSN=&HLQ..CLAIM.AUDIT,DISP=OLD
//CTL      DD DSN=&HLQ..UCF.CTL,DISP=OLD
//SYSIN    DD *
  OPTION COPY
  OUTFIL FNAMES=HDR,BUILD=(10C'0',9X,32C'0',8X,8C'0',8X,8C'0',8X,8C'0',
    414X,35C'0',8X,8C'0',
    C'UCFMS SEED RECORD - CLAIM ID ZERO - DO NOT DELETE',87X)
  OUTFIL FNAMES=ITEM,BUILD=(14C'0',66X,C'R',8C'0',8X,8C'0',91X,
    20C'0',30X)
  OUTFIL FNAMES=AUDIT,BUILD=(16C'0',20X,14C'0',C'IN',2X,13C'0',66X,
    C'CLAIMS FILES DEFINED - SEED RECORD',43X)
  OUTFIL FNAMES=CTL,BUILD=(C'CLAIMNO ',18C'0',74X)
/*
//*
//BLDAIX   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  BLDINDEX INDATASET(&HLQ..CLAIM.HDR) -
           OUTDATASET(&HLQ..CLAIM.HDR.BYUSER)
  BLDINDEX INDATASET(&HLQ..CLAIM.HDR) -
           OUTDATASET(&HLQ..CLAIM.HDR.BYSTAT)
  BLDINDEX INDATASET(&HLQ..CLAIM.ITEM) -
           OUTDATASET(&HLQ..CLAIM.ITEM.BYPROP)
  PRINT INDATASET(&HLQ..UCF.CTL) CHARACTER
  LISTCAT LEVEL(&HLQ..CLAIM) NAME
/*
