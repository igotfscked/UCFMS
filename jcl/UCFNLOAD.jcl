//UCFNLOAD JOB (ACCT),'UCF NUMI LOAD',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* OPTIONAL: LOAD THE NUMIDENT FILES INTO THE KSDS DEFINED BY UCFNDEF
//*
//* INPUT: NARA 500-COLUMN RECORDS, UPLOADED FROM THE PC AS TEXT (FTP
//*   ASCII MODE, QUOTE SITE RECFM=FB LRECL=500), ONE DATASET PER KIND.
//*   ON THE PC, "PYTHON -M UCFMS NUMI EXTRACT" WRITES THEM FROM THE
//*   DOWNLOADED FILES (FIXED OR CSV) AND CAN KEEP ONLY OWNER LAST
//*   NAMES (--ONLY-UCF-NAMES). SEE NUMIDENT.MD.
//*   A KIND YOU DID NOT UPLOAD: CHANGE ITS DD TO
//*     //CLMIN    DD DUMMY,DCB=(RECFM=FB,LRECL=500)
//*   SEVERAL FILES OF ONE KIND (NARA SENT 20): CONCATENATE THEM.
//*
//* STEP LOAD   DFSORT ICETOOL:
//*   - THREE COPIES BUILD THE 56-BYTE KEY (LAST 69-88, FIRST 37-51,
//*     SSN 13-21, KIND LETTER, REFERENCE NUM 1-11) IN FRONT OF THE
//*     UNCHANGED RECORD (556 BYTES) INTO ONE WORK FILE
//*   - SELECT SORTS ON THE KEY AND WRITES INTO THE EMPTY KSDS.
//*     A REPEATED KEY KEEPS THE FIRST RECORD; THE REST GO TO
//*     &HLQ..NUMI.DUPKEYS. TOOLMSG SHOWS HOW MANY.
//*   - NARA'S MASKED RECORDS (SSN ZZZZZZZZZ) ARE LEFT OUT.
//*   - ONLY DEATH POSTING 1 IS KEYED; POSTINGS 2-3 STAY IN THE RECORD.
//* STEP BLDAIX IDCAMS BLDINDEX BUILDS THE SSN ALTERNATE INDEX
//* STEP NUMISTAT  UCFCTLU STAMPS THE LOAD DATE IN UCF.CTL (NEEDS
//*              UCFCLDEF RUN ONCE, AND UCF.CTL CLOSED IN CICS).
//* CHANGE: JOB CARD, HLQ, INPUT DSNS, LOADLIB, SPACE (PLACEHOLDERS.MD)
//* TO RELOAD, RERUN UCFNDEF FIRST (THE KSDS MUST BE EMPTY).
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//         SET DTHDSN=UCF.NUMI.UPLOAD.DEATH
//         SET CLMDSN=UCF.NUMI.UPLOAD.CLAIM
//         SET SS5DSN=UCF.NUMI.UPLOAD.SS5
//         SET LOADLIB=UCF.PROD.LOADLIB
//*
//CLEANUP  EXEC PGM=IEFBR14
//DUPS     DD DSN=&HLQ..NUMI.DUPKEYS,DISP=(MOD,DELETE,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//LOAD     EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//DTHIN    DD DSN=&DTHDSN,DISP=SHR
//CLMIN    DD DSN=&CLMDSN,DISP=SHR
//SS5IN    DD DSN=&SS5DSN,DISP=SHR
//ALL      DD DSN=&&ALL,DISP=(MOD,DELETE,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(5000,1000),RLSE),DSNTYPE=LARGE,
//             DCB=(RECFM=FB,LRECL=556,BLKSIZE=0)
//KSDS     DD DSN=&HLQ..NUMI.KSDS,DISP=OLD
//DUPS     DD DSN=&HLQ..NUMI.DUPKEYS,
//             DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(50,50),RLSE),
//             DCB=(RECFM=FB,LRECL=556,BLKSIZE=0)
//TOOLIN   DD *
  COPY   FROM(DTHIN) TO(ALL) USING(CTLD)
  COPY   FROM(CLMIN) TO(ALL) USING(CTLC)
  COPY   FROM(SS5IN) TO(ALL) USING(CTLS)
  SELECT FROM(ALL) TO(KSDS) ON(1,56,CH) FIRST DISCARD(DUPS)
  COUNT  FROM(DUPS)
/*
//CTLDCNTL DD *
  OMIT COND=(13,9,CH,EQ,C'ZZZZZZZZZ')
  INREC BUILD=(69,20,37,15,13,9,C'D',1,11,1,500)
/*
//CTLCCNTL DD *
  OMIT COND=(13,9,CH,EQ,C'ZZZZZZZZZ')
  INREC BUILD=(69,20,37,15,13,9,C'C',1,11,1,500)
/*
//CTLSCNTL DD *
  OMIT COND=(13,9,CH,EQ,C'ZZZZZZZZZ')
  INREC BUILD=(69,20,37,15,13,9,C'S',1,11,1,500)
/*
//*
//BLDAIX   EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//IDCUT1   DD UNIT=SYSDA,SPACE=(CYL,(500,100)),DISP=(NEW,DELETE)
//IDCUT2   DD UNIT=SYSDA,SPACE=(CYL,(500,100)),DISP=(NEW,DELETE)
//SYSIN    DD *,SYMBOLS=JCLONLY
  BLDINDEX INDATASET(&HLQ..NUMI.KSDS) -
           OUTDATASET(&HLQ..NUMI.SSN.AIX) -
           EXTERNALSORT
  LISTCAT ENTRIES(&HLQ..NUMI.KSDS &HLQ..NUMI.SSN.AIX) ALL
/*
//*
//NUMISTAT EXEC PGM=UCFCTLU,COND=(4,LT),
//             PARM='NUMISTAT,&HLQ..NUMI.KSDS'
//STEPLIB  DD DSN=&LOADLIB,DISP=SHR
//UCFCTL   DD DSN=&HLQ..UCF.CTL,DISP=SHR
//SYSOUT   DD SYSOUT=*
