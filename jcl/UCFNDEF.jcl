//UCFNDEF  JOB (ACCT),'UCF NUMI DEFINE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* OPTIONAL: DEFINE THE SSA NUMIDENT REFERENCE FILE (SEE NUMIDENT.MD).
//* NOTHING IN THE OWNER OR CLAIMS FILES DEPENDS ON IT. IF IT IS NEVER
//* LOADED, QUERY JUST HIDES THE NUMIDENT FUNCTION.
//*
//*  BASE KSDS  &HLQ..NUMI.KSDS   (COPYBOOK UCFNUMI)
//*    RECORD = 556 BYTES = 56-BYTE KEY PREFIX + NARA 500-COLUMN RECORD
//*      1- 20  KEY: NH LAST NAME   (NARA COLS 69-88)
//*     21- 35  KEY: NH FIRST NAME  (NARA COLS 37-51)
//*     36- 44  KEY: SSN            (NARA COLS 13-21)
//*     45      KEY: KIND  D=DEATH C=CLAIM S=SS-5
//*     46- 56  KEY: REFERENCE NUM  (NARA COLS 1-11)
//*     57-556  NARA RECORD, UNCHANGED (NARA COLUMN + 56)
//*    KEYS(56 0). A LAST NAME (OR LAST + FIRST) IS A GENERIC KEY.
//*
//*  ALTERNATE INDEX  &HLQ..NUMI.SSN.AIX
//*    KEY = SSN IN THE NARA RECORD: OFFSET 56+12=68, LEN 9
//*    NONUNIQUE: A PERSON HAS A DEATH RECORD, CLAIMS AND SEVERAL SS-5
//*    VERSIONS (30+ AT MOST, SO 8000 BYTES IS PLENTY).
//*    READ IT THROUGH THE PATH &HLQ..NUMI.SSN.PATH
//*
//* SPACE IS SIZED FOR ABOUT 20 MILLION RECORDS, WHAT IS LEFT AFTER
//* KEEPING ONLY OWNER LAST NAMES (NUMIDENT.MD). ALL 147 MILLION NEED
//* ABOUT 100,000 CYLINDERS AND AN EXTENDED-ADDRESSABILITY DATA CLASS.
//*
//* CHANGE: JOB CARD, HLQ, SPACE, DATACLAS (SEE PLACEHOLDERS.MD)
//* RERUNNABLE: DELETES THE CLUSTER (AND ITS AIX/PATH) FIRST.
//* RUN UCFNLOAD AFTER THIS JOB.
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  DELETE &HLQ..NUMI.KSDS CLUSTER PURGE
  SET MAXCC = 0

  DEFINE CLUSTER ( -
           NAME(&HLQ..NUMI.KSDS) -
           INDEXED -
           KEYS(56 0) -
           RECORDSIZE(556 556) -
           FREESPACE(0 0) -
           SHAREOPTIONS(2 3) -
           SPEED -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA ( -
           NAME(&HLQ..NUMI.KSDS.DATA) -
           CYLINDERS(14000 2000) -
           CONTROLINTERVALSIZE(18432) -
         ) -
         INDEX ( -
           NAME(&HLQ..NUMI.KSDS.INDEX) -
         )

  DEFINE ALTERNATEINDEX ( -
           NAME(&HLQ..NUMI.SSN.AIX) -
           RELATE(&HLQ..NUMI.KSDS) -
           KEYS(9 68) -
           NONUNIQUEKEY -
           UPGRADE -
           RECORDSIZE(70 8000) -
           FREESPACE(0 0) -
           SHAREOPTIONS(2 3) -
  /*       DATACLAS(XXXXXXXX)  */ -
         ) -
         DATA ( -
           NAME(&HLQ..NUMI.SSN.AIX.DATA) -
           CYLINDERS(1500 300) -
           CONTROLINTERVALSIZE(8192) -
         ) -
         INDEX ( -
           NAME(&HLQ..NUMI.SSN.AIX.INDEX) -
         )

  DEFINE PATH ( -
           NAME(&HLQ..NUMI.SSN.PATH) -
           PATHENTRY(&HLQ..NUMI.SSN.AIX) -
         )

  LISTCAT ENTRIES(&HLQ..NUMI.KSDS) ALL
/*
