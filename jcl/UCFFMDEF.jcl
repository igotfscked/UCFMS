//UCFFMDEF JOB (ACCT),'UCF FORMS DEFINE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* ALLOCATE THE COMPTROLLER-FORMS DATASETS (DESIGN/FORMS/FORMS.MD)
//*
//*  &HLQ..UCF.FORMS    RECFM=VB LRECL=255. BATCH STEP UCFFORM WRITES
//*                     ONE FDF MEMBER PER CLAIM (C + LAST 7 DIGITS OF
//*                     THE CLAIM ID). ALLOCATED AS A PDSE
//*                     (DSNTYPE=LIBRARY): ONE MEMBER PER CLAIM WOULD
//*                     FILL A PDS DIRECTORY AND NEED REGULAR COMPRESSES.
//*                     FTP, ZOWE AND ISPF TREAT IT LIKE A PDS.
//*  &HLQ..UCF.PARMLIB  RECFM=FB LRECL=80 PDSE. SEEDED WITH MEMBER
//*                     DESIGNEE: YOUR FIRM AS PRINTED ON FORMS 53-125
//*                     AND 53-126, AS KEYWORD=VALUE LINES. EVERY VALUE
//*                     BELOW IS A PLACEHOLDER; EDIT THEM IN ISPF.
//*
//* RUN ONCE. THIS JOB NEVER DELETES: IF EITHER DATASET EXISTS, THE
//* ALLOCATION FAILS AND NOTHING IS CHANGED.
//* CHANGE: JOB CARD, HLQ, SPACE, DESIGNEE VALUES (SEE PLACEHOLDERS.MD)
//*--------------------------------------------------------------------
//         SET HLQ=UCF.PROD
//*
//ALLOC    EXEC PGM=IEFBR14
//FORMS    DD DSN=&HLQ..UCF.FORMS,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(50,50)),DSNTYPE=LIBRARY,
//             DCB=(RECFM=VB,LRECL=255,BLKSIZE=0)
//PARMLIB  DD DSN=&HLQ..UCF.PARMLIB,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5)),DSNTYPE=LIBRARY,
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//*
//DESIGNEE EXEC PGM=IEBUPDTE,PARM=NEW,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSUT2   DD DSN=&HLQ..UCF.PARMLIB,DISP=OLD
//SYSIN    DD DATA,DLM=$$
./ ADD NAME=DESIGNEE
* UCFMS DESIGNEE: PRINTED ON COMPTROLLER FORMS 53-125 AND 53-126.
* ONE KEYWORD=VALUE PER LINE. REPLACE EVERY PLACEHOLDER VALUE.
PERSON=*** DESIGNEE PERSON NAME ***
ENTITY=*** DESIGNEE FIRM NAME ***
ADDR1=*** DESIGNEE STREET ADDRESS ***
ADDR2=*** DESIGNEE CITY STATE ZIP ***
PHONE=*** DESIGNEE PHONE ***
FAX=*** DESIGNEE FAX ***
PILIC=*** PRIVATE INVESTIGATOR LICENSE NO ***
TXPRNO=*** SALES TAXPAYER NO ***
./ ENDUP
$$
